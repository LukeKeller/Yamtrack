# Yamtrack development environment.
# Copy to .env and fill in. The app boots with just SECRET + DEBUG set;
# everything else is optional but features degrade gracefully without keys.

# --- Required for boot --------------------------------------------------
SECRET=dev-secret-not-for-production
DEBUG=True
URLS=http://localhost:8000

# --- Cache + Celery broker ---------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Database ----------------------------------------------------------
# Leave DB_HOST unset (or absent) for the default SQLite. Uncomment to
# point at a local Postgres instead.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=yamtrack
# DB_USER=yamtrack
# DB_PASSWORD=

# --- Provider API keys (all optional) ----------------------------------
# Without these, searches against the corresponding provider will fail
# but the app still runs and existing library data still renders.
TMDB_API=
OMDB_API=
TVDB_API=
MAL_API=
IGDB_ID=
IGDB_SECRET=
BGG_API_TOKEN=
STEAM_API_KEY=
HARDCOVER_API=
COMICVINE_API=
DISCOGS_API=
TRAKT_API=
TRAKT_API_SECRET=

# --- Deploy-only settings (leave defaults during local dev) -----------
# BASE_URL=                # subpath prefix, e.g. /yamtrack
# ADMIN_ENABLED=False
# TRACK_TIME=True
# TZ=UTC
